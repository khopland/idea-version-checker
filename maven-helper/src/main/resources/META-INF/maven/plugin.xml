<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>Version Checker metadata helper</name>
  <description>Read-only metadata batches using the current Maven resolution session.</description>
  <groupId>io.github.khopland</groupId><artifactId>version-checker-maven-helper</artifactId><version>@helperVersion@</version>
  <goalPrefix>version-checker-metadata</goalPrefix><isolatedRealm>false</isolatedRealm>
  <requiredJavaVersion>17</requiredJavaVersion><requiredMavenVersion>3.6.3</requiredMavenVersion>
  <mojos><mojo>
    <goal>lookup</goal><description>Look up repository metadata and plugin prerequisites.</description>
    <requiresDirectInvocation>false</requiresDirectInvocation><requiresProject>true</requiresProject>
    <requiresReports>false</requiresReports><aggregator>false</aggregator><requiresOnline>true</requiresOnline>
    <inheritedByDefault>false</inheritedByDefault>
    <implementation>io.github.khopland.versionchecker.helper.MetadataMojo</implementation>
    <language>java</language><instantiationStrategy>per-lookup</instantiationStrategy>
    <executionStrategy>once-per-session</executionStrategy><threadSafe>true</threadSafe>
    <parameters>
      <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>Current project.</description></parameter>
      <parameter><name>session</name><type>org.apache.maven.execution.MavenSession</type><required>true</required><editable>false</editable><description>Current session.</description></parameter>
      <parameter><name>input</name><type>java.io.File</type><required>true</required><editable>true</editable><description>Batch request.</description></parameter>
      <parameter><name>output</name><type>java.io.File</type><required>true</required><editable>true</editable><description>Batch response.</description></parameter>
      <parameter><name>threads</name><type>int</type><required>true</required><editable>true</editable><description>Bounded metadata concurrency.</description></parameter>
    </parameters>
    <configuration>
      <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
      <session implementation="org.apache.maven.execution.MavenSession" default-value="${session}"/>
      <input implementation="java.io.File">${versionchecker.input}</input>
      <output implementation="java.io.File">${versionchecker.output}</output>
      <threads implementation="int" default-value="2">${versionchecker.threads}</threads>
    </configuration>
    <requirements>
      <requirement><role>org.eclipse.aether.RepositorySystem</role><field-name>repositorySystem</field-name></requirement>
      <requirement><role>org.apache.maven.project.ProjectBuilder</role><field-name>projectBuilder</field-name></requirement>
    </requirements>
  </mojo></mojos>
  <dependencies/>
</plugin>
