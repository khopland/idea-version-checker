<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection shortName="NewerGradleDependencyVersion" displayName="Newer Gradle dependency version available" groupName="Gradle" enabledByDefault="true" level="WARNING" implementationClass="io.github.khopland.versionchecker.gradle.NewerGradleDependencyInspection" />
        <localInspection shortName="NewerGradleWrapperVersion" displayName="Newer Gradle wrapper version available" groupName="Gradle" enabledByDefault="true" level="WARNING" implementationClass="io.github.khopland.versionchecker.gradle.GradleWrapperVersionInspection" />
    </extensions>
    <extensions defaultExtensionNs="io.github.khopland.version-checker">
        <buildSystemAdapter implementation="io.github.khopland.versionchecker.gradle.GradleBuildSystemAdapter" />
        <buildSystemAdapter implementation="io.github.khopland.versionchecker.gradle.GradleWrapperAdapter" />
    </extensions>
</idea-plugin>
