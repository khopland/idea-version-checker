<idea-plugin>
    <id>io.github.khopland.version-checker</id>
    <name>Version Checker</name>
    <vendor>khopland</vendor>
    <description><![CDATA[
        <p>Highlights outdated dependency versions in your build files and updates them by patch, minor or major.</p>
        <ul>
          <li><b>Maven:</b> dependencies, BOMs, build plugins and version properties, with fixes that remove redundant overrides and duplicates.</li>
          <li><b>npm:</b> dependencies, overrides, resolutions, catalogs and <code>packageManager</code> in <code>package.json</code> and <code>pnpm-workspace.yaml</code>, for npm, pnpm, Yarn and Bun projects, and packages listed twice.</li>
          <li><b>Gradle:</b> libraries and plugins in build scripts, <code>gradle.properties</code> and <code>libs.versions.toml</code>, from the repositories the build declares, and unused catalog entries.</li>
          <li>The Maven and Gradle wrappers, <code>.nvmrc</code>, <code>.node-version</code>, <code>.sdkmanrc</code> and <code>.tool-versions</code>.</li>
          <li>GitHub Actions in workflows and <code>action.yml</code>.</li>
        </ul>
        <p>Use <b>Alt+Enter</b> on a version to update it or open its release notes, or <b>Tools | Versions</b> to update a file or the whole project in one undoable edit.
        The <b>Dependency Updates</b> tool window lists every outdated version in the project, with its patch, minor and major update.
        A minimum release age hides new Maven and Gradle releases, for example to match a Nexus quarantine.
        A suppress comment keeps a version on purpose.</p>
        <p>Optionally, known vulnerabilities of declared Maven, Gradle and npm dependencies from OSV.dev, with a fix to the nearest safe version,
        and of the packages they bring in, in Maven, npm and pnpm projects.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="version-checker-maven.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="version-checker-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="version-checker-yaml.xml">org.jetbrains.plugins.yaml</depends>

    <extensionPoints>
        <extensionPoint name="declarationProvider" interface="io.github.khopland.versionchecker.core.DeclarationProvider" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <externalAnnotator language="XML" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <externalAnnotator language="JSON" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <externalAnnotator language="kotlin" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <externalAnnotator language="Groovy" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <externalAnnotator language="TOML" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <externalAnnotator language="Properties" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <externalAnnotator language="TEXT" implementationClass="io.github.khopland.versionchecker.core.VersionAnnotator"/>
        <fileType name="PLAIN_TEXT" fileNames=".nvmrc;.node-version;.sdkmanrc;.tool-versions"/>
        <externalAnnotator language="XML" implementationClass="io.github.khopland.versionchecker.core.VulnerabilityAnnotator"/>
        <externalAnnotator language="JSON" implementationClass="io.github.khopland.versionchecker.core.VulnerabilityAnnotator"/>
        <externalAnnotator language="kotlin" implementationClass="io.github.khopland.versionchecker.core.VulnerabilityAnnotator"/>
        <externalAnnotator language="Groovy" implementationClass="io.github.khopland.versionchecker.core.VulnerabilityAnnotator"/>
        <externalAnnotator language="TOML" implementationClass="io.github.khopland.versionchecker.core.VulnerabilityAnnotator"/>
        <localInspection shortName="OutdatedDependencyVersion" displayName="Outdated dependency version" groupName="Version Checker"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.khopland.versionchecker.core.OutdatedVersionInspection"/>
        <lang.inspectionSuppressor language="TOML" implementationClass="io.github.khopland.versionchecker.core.LineCommentSuppressor"/>
        <localInspection shortName="MovedDependency" displayName="Moved dependency" groupName="Version Checker"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="io.github.khopland.versionchecker.core.MovedDependencyInspection"/>
        <localInspection shortName="VulnerableDependency" displayName="Vulnerable dependency version" groupName="Version Checker"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.khopland.versionchecker.core.VulnerableDependencyInspection"/>
        <!-- Its annotator runs where the build tool's resolved packages are known: Maven projects and npm and pnpm lockfiles. -->
        <localInspection shortName="VulnerableTransitiveDependency" displayName="Vulnerable transitive dependency" groupName="Version Checker"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.khopland.versionchecker.core.VulnerableTransitiveDependencyInspection"/>
        <localInspection language="TOML" shortName="UnusedCatalogEntry" displayName="Unused version catalog entry" groupName="Version Checker"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="io.github.khopland.versionchecker.gradle.UnusedCatalogEntryInspection"/>
        <applicationConfigurable parentId="tools" id="version.checker" displayName="Version Checker"
                                 instance="io.github.khopland.versionchecker.VersionCheckerConfigurable"/>
        <notificationGroup id="Version Checker" displayType="BALLOON"/>
        <toolWindow id="Dependency Updates" anchor="bottom" icon="io.github.khopland.versionchecker.VersionCheckerIcons.ToolWindow"
                    factoryClass="io.github.khopland.versionchecker.DependencyUpdatesToolWindowFactory" doNotActivateOnStart="true"/>
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>

    <extensions defaultExtensionNs="io.github.khopland.version-checker">
        <declarationProvider implementation="io.github.khopland.versionchecker.gradle.GradleProvider"/>
        <declarationProvider implementation="io.github.khopland.versionchecker.wrapper.GradleWrapperProvider"/>
        <declarationProvider implementation="io.github.khopland.versionchecker.wrapper.MavenWrapperProvider"/>
        <declarationProvider implementation="io.github.khopland.versionchecker.toolchain.NodeVersionProvider"/>
        <declarationProvider implementation="io.github.khopland.versionchecker.toolchain.SdkmanProvider"/>
        <declarationProvider implementation="io.github.khopland.versionchecker.toolchain.ToolVersionsProvider"/>
    </extensions>

    <actions>
        <group id="VersionChecker.Menu" text="Versions" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <group id="VersionChecker.UpdateFile" text="Update This File" popup="true">
                <action id="VersionChecker.UpdateFile.Patch" class="io.github.khopland.versionchecker.UpdateFilePatchAction" text="Patch" description="Update each version in the selected build files to the newest patch release"/>
                <action id="VersionChecker.UpdateFile.Minor" class="io.github.khopland.versionchecker.UpdateFileMinorAction" text="Minor" description="Update each version in the selected build files to the newest minor or patch release"/>
                <action id="VersionChecker.UpdateFile.Major" class="io.github.khopland.versionchecker.UpdateFileMajorAction" text="Major" description="Update each version in the selected build files to the newest release"/>
            </group>
            <group id="VersionChecker.UpdateAll" text="Update All Files" popup="true">
                <action id="VersionChecker.UpdateAll.Patch" class="io.github.khopland.versionchecker.UpdateAllPatchAction" text="Patch" description="Update each version in the project to the newest patch release"/>
                <action id="VersionChecker.UpdateAll.Minor" class="io.github.khopland.versionchecker.UpdateAllMinorAction" text="Minor" description="Update each version in the project to the newest minor or patch release"/>
                <action id="VersionChecker.UpdateAll.Major" class="io.github.khopland.versionchecker.UpdateAllMajorAction" text="Major" description="Update each version in the project to the newest release"/>
            </group>
            <separator/>
            <action id="VersionChecker.ShowUpdates" class="io.github.khopland.versionchecker.ShowDependencyUpdatesAction" text="Show Dependency Updates" description="List every outdated version in the project"/>
            <action id="VersionChecker.CheckNow" class="io.github.khopland.versionchecker.CheckNowAction" text="Check Now" description="Read repository metadata again and check the open build files"/>
        </group>
        <group id="VersionChecker.ContextMenu">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <separator/>
            <reference ref="VersionChecker.UpdateFile"/>
        </group>
    </actions>
</idea-plugin>
