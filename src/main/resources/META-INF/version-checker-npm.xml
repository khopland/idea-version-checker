<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="JSON" shortName="NewerNpmDependencyVersion" displayName="Newer npm dependency version available" groupName="npm" enabledByDefault="true" level="WARNING" implementationClass="io.github.khopland.versionchecker.npm.NewerNpmDependencyInspection" />
    </extensions>
    <extensions defaultExtensionNs="io.github.khopland.version-checker">
        <buildSystemAdapter implementation="io.github.khopland.versionchecker.npm.NpmBuildSystemAdapter" />
    </extensions>
</idea-plugin>
