<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="XML" shortName="RedundantMavenOverride" displayName="Redundant Maven override" groupName="Version Checker"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="io.github.khopland.versionchecker.maven.RedundantOverrideInspection"/>
    </extensions>
    <extensions defaultExtensionNs="io.github.khopland.version-checker">
        <declarationProvider implementation="io.github.khopland.versionchecker.maven.MavenProvider"/>
    </extensions>
</idea-plugin>
