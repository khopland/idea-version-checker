<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="JSON" shortName="DuplicateNpmDependency" displayName="Duplicate npm dependency" groupName="Version Checker"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="io.github.khopland.versionchecker.npm.DuplicateDependencyInspection"/>
        <externalAnnotator language="JSON" implementationClass="io.github.khopland.versionchecker.core.TransitiveVulnerabilityAnnotator"/>
        <lang.inspectionSuppressor language="JSON" implementationClass="io.github.khopland.versionchecker.npm.KeptVersionSuppressor"/>
    </extensions>
    <applicationListeners>
        <listener class="io.github.khopland.versionchecker.npm.LockfileListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>
    <extensions defaultExtensionNs="io.github.khopland.version-checker">
        <declarationProvider implementation="io.github.khopland.versionchecker.npm.NpmProvider"/>
    </extensions>
</idea-plugin>
