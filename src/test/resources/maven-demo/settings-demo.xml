<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!-- Optional: this mirror makes the repository selected by settings visible
         in Maven's logs. Replace the URL with your own repository if desired. -->
    <mirrors>
        <mirror>
            <id>demo-settings-mirror</id>
            <name>Demo mirror configured through settings.xml</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
